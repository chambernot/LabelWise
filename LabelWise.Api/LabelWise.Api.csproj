<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <UserSecretsId>3b06fb5d-c541-41d9-bf46-849b29ab7e94</UserSecretsId>

    <!-- Docker / Render -->
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>

    <!-- Garante que os assemblies/runtime assets sejam copiados para o output -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <!-- ================================================================ -->
  <!-- PROJECT REFERENCES                                                -->
  <!-- ================================================================ -->
  <ItemGroup>
    <ProjectReference Include="..\LabelWise.Application\LabelWise.Application.csproj" />
    <ProjectReference Include="..\LabelWise.Infrastructure\LabelWise.Infrastructure.csproj" />
    <ProjectReference Include="..\LabelWise.Shared\LabelWise.Shared.csproj" />
  </ItemGroup>

  <!-- ================================================================ -->
  <!-- NUGET PACKAGES                                                    -->
  <!-- ================================================================ -->
  <ItemGroup>

    <PackageReference Include="Google_GenerativeAI" Version="3.6.7" />

    <PackageReference Include="Microsoft.ApplicationInsights.AspNetCore" Version="3.1.0" />

    <PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.23.0" />

    <PackageReference Include="OpenCvSharp4" Version="4.10.0.20240616" />

    <PackageReference Include="Swashbuckle.AspNetCore" Version="7.3.0" />

    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.0" />

  </ItemGroup>

  <!-- ================================================================ -->
  <!-- OPENCV - WINDOWS                                                  -->
  <!-- Desenvolvimento local no Windows                                 -->
  <!-- ================================================================ -->
  <ItemGroup Condition="'$(OS)' == 'Windows_NT'">

    <PackageReference Include="OpenCvSharp4.runtime.win" Version="4.10.0.20240616" />

  </ItemGroup>

  <!-- ================================================================ -->
  <!-- OPENCV - LINUX                                                    -->
  <!-- Render / Docker / Linux                                           -->
  <!-- ================================================================ -->
  <ItemGroup Condition="'$(OS)' != 'Windows_NT'">

    <PackageReference Include="OpenCvSharp4.official.runtime.linux-x64" Version="4.13.0.20260627" />

  </ItemGroup>

  <!-- ================================================================ -->
  <!-- TESSERACT OCR                                                     -->
  <!-- Copia tessdata automaticamente para output/publish               -->
  <!-- ================================================================ -->
  <ItemGroup>

    <Content Include="tessdata\*.traineddata" Condition="Exists('tessdata')">

      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>

      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>

    </Content>

  </ItemGroup>

  <!-- ================================================================ -->
  <!-- GARANTE DIRETÓRIO TESSDATA                                        -->
  <!-- ================================================================ -->
  <Target Name="EnsureTessdataDirectory" BeforeTargets="Build">

    <Message Text="Verificando diretório tessdata..." Importance="high" />

    <MakeDir Directories="$(ProjectDir)tessdata" Condition="!Exists('$(ProjectDir)tessdata')" />

    <Message Text="Diretório tessdata garantido em: $(ProjectDir)tessdata" Importance="high" Condition="Exists('$(ProjectDir)tessdata')" />

    <Warning Text="ATENÇÃO: Diretório tessdata criado mas vazio. O OCR não funcionará até que os arquivos .traineddata sejam adicionados." Condition="Exists('$(ProjectDir)tessdata') AND !Exists('$(ProjectDir)tessdata\por.traineddata')" />

  </Target>

  <!-- ================================================================ -->
  <!-- LISTA ARQUIVOS TESSDATA APÓS BUILD                                -->
  <!-- ================================================================ -->
  <Target Name="ListTessdataFiles" AfterTargets="Build">

    <ItemGroup>

      <TessdataFiles Include="$(OutputPath)tessdata\*.traineddata" />

    </ItemGroup>

    <Message Text="Arquivos tessdata copiados: @(TessdataFiles->'%(Filename)%(Extension)')" Importance="high" Condition="'@(TessdataFiles)' != ''" />

    <Warning Text="ATENÇÃO: Nenhum arquivo .traineddata encontrado em tessdata. OCR não funcionará!" Condition="'@(TessdataFiles)' == ''" />

  </Target>

  <!-- ================================================================ -->
  <!-- VISUAL STUDIO                                                     -->
  <!-- ================================================================ -->
  <ProjectExtensions>
    <VisualStudio>
      <UserProperties appsettings_1json__JsonSchema="https://www.schemastore.org/assetlinks.json" />
    </VisualStudio>
  </ProjectExtensions>

</Project>